{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://projects.blender.org/lab/blender_mcp.git@v1.0.3#subdirectory=mcp",
        "blender-mcp"
      ],
      "env": {}
    },
    "graft": {
      "command": "npx",
      "args": [
        "-y",
        "@nanonets/graft",
        "mcp"
      ]
    }
  }
}
